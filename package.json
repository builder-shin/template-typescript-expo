{
  "name": "template-typescript-expo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "expo start",
    "types:routes": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.49.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.3",
    "@types/react": "~19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "metro": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "5.0.2"
  }
